@"
# Python
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Node
node_modules/
dist/

# Environment and local files
.env
.DS_Store
*.log
training_output.txt

# Trained model is regenerated by scripts/train_model.py
backend/models/*.joblib
"@ | Set-Content -Path .gitignore -Encoding ascii

Get-Item .gitignore | ForEach-Object { "{0,6}  {1}" -f $_.Length, $_.Name }